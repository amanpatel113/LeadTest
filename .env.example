MONGO_URI=mongodb://127.0.0.1:27017
PORT=4000
DELAY_MS=3000
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=change-me
# Token for server/marketing-calls.js (App Review > Testing call count). Needs ads_read.
MARKETING_API_TOKEN=

# Two Meta apps, chosen with the toggle on the home page. Everything is required except the verify token and webhook URL.
# Staging
STAGING_META_APP_ID=
STAGING_META_APP_SECRET=
# Optional: only needed to save the webhook subscription in Meta's dashboard (any string you choose)
STAGING_META_VERIFY_TOKEN=
STAGING_PAGE_ID=
STAGING_PAGE_ACCESS_TOKEN=
# Optional: if set, each test lead is also sent here as a signed leadgen POST (replays Meta's delivery for an unpublished app)
STAGING_WEBHOOK_URL=

# Production
PRODUCTION_META_APP_ID=
PRODUCTION_META_APP_SECRET=
# Optional, as above
PRODUCTION_META_VERIFY_TOKEN=
PRODUCTION_PAGE_ID=
PRODUCTION_PAGE_ACCESS_TOKEN=
PRODUCTION_WEBHOOK_URL=
